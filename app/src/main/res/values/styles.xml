<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YaranTV" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/purple_primary</item>
        <item name="android:statusBarColor">@color/purple_dark</item>
        <item name="android:navigationBarColor">@color/purple_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/purple_dark</item>
    </style>

    <style name="Theme.YaranTV.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/purple_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/purple_primary</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.YaranTV</item>
        <item name="android:windowBackground">@color/purple_dark</item>
    </style>
</resources>
